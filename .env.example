# Copy values you need into .env. Never commit a real key or private key.
KALSHI_ENV=demo
KALSHI_TRADING_ENABLED=false
# Live posting needs a production API key with write or write::trade scope.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
ORDER_EXPIRY_SECONDS=300
RECONCILE_INTERVAL_SECONDS=15
METADATA_TTL_SECONDS=30
UI_UPDATE_INTERVAL_MS=33
UI_STREAM_TIMEOUT_SECONDS=5
FEED_HEALTH_TIMEOUT_SECONDS=15
